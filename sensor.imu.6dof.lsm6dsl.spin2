#include "sensor.accel.common.spin2h"           ' pull in code common to all accelerometer
#include "sensor.gyroscope.common.spin2h"       '   and gyroscope drivers

CON

    { /// default I/O settings; these can be overridden in the parent object }
    { I2C }
    SCL                 = 28
    SDA                 = 29
    I2C_FREQ            = 100_000
    I2C_ADDR            = 0

    { SPI }
    CS                  = 0
    SCK                 = 1
    MOSI                = 2
    MISO                = 3
    SPI_FREQ            = 1_000_000             ' max is 10MHz

    INT_PIN             = 4
    { /// }

' Constants used for I2C mode only
    SLAVE_WR            = core.SLAVE_ADDR
    SLAVE_RD            = core.SLAVE_ADDR|1


' FIFO specifications
    FIFO_SIZE           = 4096              ' bytes
    FIFO_UNIT           = 2                 ' 1: bytes, 2: words, 4: longs
    FIFO_SAMPLES_MAX    = (FIFO_SIZE / FIFO_UNIT)-1

' Indicate to user apps how many Degrees of Freedom each sub-sensor has
'   (also imply whether or not it has a particular sensor)
    ACCEL_DOF           = 3
    GYRO_DOF            = 3
    MAG_DOF             = 0
    BARO_DOF            = 0
    DOF                 = ACCEL_DOF + GYRO_DOF + MAG_DOF + BARO_DOF

' Scales and data rates used during calibration/bias/offset process
    CAL_XL_SCL          = 2
    CAL_G_SCL           = 250
    CAL_M_SCL           = 0
    CAL_XL_DR           = 104
    CAL_G_DR            = 104
    CAL_M_DR            = 0

' Constants used in low-level SPI read/write
    READ                = 1 << 7
    WRITE               = 0

' Axis-specific constants
    X_AXIS              = 0
    Y_AXIS              = 1
    Z_AXIS              = 2
    ALL_AXIS            = 3

' Gyroscope operating modes
    NORM                = 0
    SLEEP               = 1

' Accel/Gyro sleep power modes
    NORMAL              = 0
    LOPWR               = 1
    LOPWR_GSLEEP        = 2
    LOPWR_GPWROFF       = 3

' Accelerometer operating modes
    XL_HIPERF           = 0
    XL_NORM             = 1

' INT1 interrupts
    INACTIVE            = 1 << 7
    SNGTAP              = 1 << 6
    WAKEUP              = 1 << 5
    FREEFALL            = 1 << 4
    DBLTAP              = 1 << 3
    SIXD                = 1 << 2
    TILT                = 1 << 1
    TMR_END             = 1

' FIFO operating modes
    OFF                 = %000
    FIFO                = %001
    CONT_TRIG           = %011
    OFF_TRIG            = %100
    CONT                = %110

' Output data source
    GYRO_LIVE           = 0
    GYRO_FIFO           = 1
    ACCEL_LIVE          = 0
    ACCEL_FIFO          = 1

VAR

    long _CS
    byte _adata_src, _gdata_src

OBJ

{ SPI? }
#ifdef LSM6DSL_SPI
    spi:    "com.spi.25mhz"                     ' SPI engine
#else
{ no, not SPI - default to I2C }
#   define LSM6DSL_I2C
    i2c:    "com.i2c"                           ' I2C engine
#endif
    core:   "core.con.lsm6dsl"                  ' hw-specific low-level const's


PUB null()
' This is not a top-level object


#ifdef LSM6DSL_I2C
PUB start(): s
' Start the driver using default I/O settings
    return startx(SCL, SDA, I2C_FREQ, I2C_ADDR)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ, ADDR_BITS): status
' Start using custom IO pins
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitus(core.T_POR)                  ' wait for device startup
            _bank_sel := -1                     ' init bank select
            if ( dev_id() == core.DEVID_RESP )  ' validate device
                return
    ' if this point is reached, something above failed
    ' Re-check I/O pin assignments, bus speed, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE

#elseifdef LSM6DSL_SPI

PUB start(): s
' Start the driver using default I/O settings
    return startx(CS, SCK, MOSI, MISO)


PUB startx(CS_PIN, SCK_PIN, MOSI_PIN, MISO_PIN, SCK_FREQ=1_000_000): status
' Start using custom IO pins
    if (lookdown(CS_PIN: 0..63) and lookdown(SCK_PIN: 0..63) and ...
        lookdown(MOSI_PIN: 0..63) and lookdown(MISO_PIN: 0..63) )
        if ( status := spi.init(SCK_PIN, MOSI_PIN, MISO_PIN, core.SPI_MODE, SCK_FREQ) )
            waitus(core.T_POR)                  ' wait for device startup
            _CS := CS_PIN
            _bank_sel := -1                     ' init bank select
            if (dev_id() == core.DEVID_RESP)    ' validate device
                return
    ' if this point is reached, something above failed
    ' Re-check I/O pin assignments, bus speed, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE
#endif

PUB stop()
' Stop the driver
#ifdef LSM6DSL_I2C
    i2c.deinit()
#elseifdef LSM6DSL_SPI
    spi.deinit()
#endif
    _CS := _adata_src := _gdata_src := 0


PUB defaults()
' Set factory defaults
    reset()


PUB preset_freefall()
' Like defaults(), but sets:
'   * Sensor powered up/actively measuring
'   * Accelerometer: 2g, 416Hz
'   * Gyroscope: 250dps, 52Hz
'   * Free-fall duration: 6 samples
'   * Free-fall threshold: 312mg
    reset()
    blk_updt_ena()
    accel_data_rate(416)
    accel_scale(2)
    gyro_data_rate(52)
    gyro_scale(250)
    freefall_time(6)
    freefall_thresh(312)
    click_int_ena(TRUE)


PUB preset_active()
' Like Defaults(), but sets:
'   * Sensor powered up/actively measuring
'   * Accelerometer: 2g, 52Hz
'   * Gyroscope: 250dps, 52Hz
    reset()
    blk_updt_ena()
    accel_data_rate(52)
    accel_scale(2)
    gyro_data_rate(52)
    gyro_scale(250)


PUB preset_click_det()
' Presets for click-detection
    reset()
    accel_scale(2)
    accel_data_rate(416)
    click_thresh(0_125000)
    click_axis_ena(%111)
    click_time(38)
    click_latency(9)
    click_int_ena(TRUE)
    int1_mask(SNGTAP)


PUB preset_pedometer()
' Presets for pedometer functionality
    reset()
    blk_updt_ena()
    accel_data_rate(52)
    accel_scale(2)
    pedometer_ena(true)
    pedometer_scale(2)
    step_reset()


PUB accel_bias(x, y, z) | tmp
' Read accelerometer calibration offset values (on-chip)
    tmp := readreg(core.X_OFS_USR, 3)
    { extend sign and copy to pointees }
    long[x] := (tmp.byte[X_AXIS] signx 7)
    long[y] := (tmp.byte[Y_AXIS] signx 7)
    long[z] := (tmp.byte[Z_AXIS] signx 7)


PUB accel_set_bias(x, y, z)
' Write accelerometer calibration offset values (on-chip)
'   Valid values:
'       -127..127
    x := -127 #> (x / _ares) <# 127
    y := -127 #> (y / _ares) <# 127
    z := -127 #> (z / _ares) <# 127
    writereg(core.X_OFS_USR, x)
    writereg(core.Y_OFS_USR, y)
    writereg(core.Z_OFS_USR, z)


PUB accel_bias_res(r=-2): c
' Set resolution of accelerometer bias/offset values, in micro-g's
'   Valid values: 0_000977 (0.000977g), 0_015625 (0.015625g)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL6_C)
    case r
        0_000977, 0_015625:
            r := lookdownz(r: 0_000977, 0_015625) << core.USR_OFF_W
            r := ((c & core.USR_OFF_W_MASK) | r)
            writereg(core.CTRL6_C, r)
        other:
            c := (c >> core.USR_OFF_W) & 1
            return lookupz(c: 0_000977, 0_015625)


PUB accel_data(ptr_x, ptr_y, ptr_z) | tmp[2]
' Read the Accelerometer output registers
    if (_adata_src == ACCEL_LIVE)               ' where should the data come from?
        readreg(core.OUTX_L_XL, 6, @tmp)        '   live sensor data (normal operation)
    else
        fifo_data(@tmp, 3)                      '   fifo data (buffered)
    long[ptr_x] := (tmp.word[X_AXIS] signx 15)
    long[ptr_y] := (tmp.word[Y_AXIS] signx 15)
    long[ptr_z] := (tmp.word[Z_AXIS] signx 15)


PUB accel_data_rate(r=-2): c
' Set accelerometer output data rate, in Hz
'   Valid values:
'       Low power mode: 0, 1 (1.6), 12 (12.5), 26, 52
'       Normal mode: 0, 104, 208
'       High-perf mode: *0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL1_XL)
    case r
        0, 1, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660:
            r := lookdownz(r: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660, 1) << core.ODR_XL
            r := ((c & core.ODR_XL_MASK) | r)
            writereg(core.CTRL1_XL, r)
        other:
            c >>= core.ODR_XL
            return lookupz(c: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660, 1)


PUB accel_data_rdy(): f
' Flag indicating new accelerometer data available
'   Returns: TRUE (-1) if new data available, FALSE (0) otherwise
    f := readreg(core.STATUS)
    return ((f & core.XLRDY) == core.XLRDY)


PUB accel_data_src(src=-2): c
' Set source of data for accel_data() output
'   Valid values:
'      *ACCEL_LIVE (0): live/current data
'       ACCEL_FIFO (1): FIFO data
'   Any other value returns the current setting
    if ((src == ACCEL_LIVE) or (src == ACCEL_FIFO))
        _adata_src := src
    else
        return _adata_src


PUB accel_opmode(m=-2): c
' Set accelerometer operating mode
'   Valid values:
'      *XL_HIPERF (0): High-performance mode
'       XL_NORM (1): Normal mode
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL6_C)
    case m
        XL_NORM, XL_HIPERF:
            m <<= core.XL_HM_MODE
            m := ((c & core.XL_HM_MODE_MASK) | m)
            writereg(core.CTRL6_C, m)
        other:
            c := (c >> core.XL_HM_MODE) & 1


PUB accel_scale(s=-2): c
' Set the full-scale range of the accelerometer, in g's
'   Valid values: *2, 4, 8, 16
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL1_XL)
    case s
        2, 4, 8, 16:
            s := lookdownz(s: 2, 16, 4, 8)
            _ares := lookupz(s: 0_061, 0_488, 0_122, 0_244)
            s <<= core.FS_XL
            s := ((c & core.FS_XL_MASK) | s)
            writereg(core.CTRL1_XL, s)
        other:
            c := ((c >> core.FS_XL) & core.FS_XL_BITS)
            return lookupz(c: 2, 16, 4, 8)


PUB accel_slp_pwr_mode(m=-2): c
' Set accelerometer power mode/oversampling mode, when sleeping
'   Valid values:
'       NORMAL (0): Normal
'       LOPWR (1): Accel Low power, gyro normal
'       LOPWR_GSLEEP (2): Accel Low power, gyro sleeps
'       LOPWR_GPWROFF (3): Accel Low power, gyro power off
'   Any other value polls the chip and returns the current setting
    c := readreg(core.TAP_CFG)
    case m
        0..3:
            m <<= core.INACT_EN
            m |= core.INTS_ENA
            m := ((c & core.INACT_EN_MASK) | m)
            writereg(core.TAP_CFG, m)
        other:
            return ((c >> core.INACT_EN) & core.INACT_EN_BITS)


PUB click_axis_ena(m=-2): c
' Enable click detection per axis
'   Valid values:
'       %000..%111 (%XYZ)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.TAP_CFG)
    case m
        %000..%111:
            m <<= core.TAP_EN
            m := ((c & core.TAP_EN_MASK) | m)
            writereg(core.TAP_CFG, m)
        other:
            return (c >> core.TAP_EN) & core.TAP_EN_BITS


PUB clicked(): f
' Flag indicating the sensor was single or double-clicked
'   Returns: TRUE (-1): sensor was clicked
    return ((clicked_int() & core.TAPPED) <> 0)


PUB clicked_int(): i
' Clicked interrupt status
'   Bit: 6..0:
'       6: Click detected
'       5: Single-click detected
'       4: Double-click detected
'       3: Click acceleration sign: 0 = positive, 1 = negative
'       2: Click detected on X-axis
'       1: Click detected on Y-axis
'       0: Click detected on Z-axis
    return readreg(core.TAP_SRC)


PUB click_int_ena(s=-2): c
' Enable click interrupts on INT1
'   Valid values: TRUE (-1 or 1), FALSE (0)
'   Any other value polls the chip and returns the current setting
    c := readreg(core.TAP_CFG)
    case abs(s)
        0, 1:
            s := abs(s) << core.INTS_EN
            s := ((c & core.INTS_EN_MASK) | s)
            writereg(core.TAP_CFG, s)
        other:
            return ((c >> core.INTS_EN) == 1)


PUB click_int_latch_ena(s=-2): c
' Enable latching click-detection interrupts
'   Valid values:
'       TRUE (-1 or 1): Interrupt asserted until status is read
'       FALSE (0): Interrupt asserted only for the event's duration
'   Any other value polls the chip and returns the current setting
    c := readreg(core.TAP_CFG, 1, @c)
    case abs(s)
        0, 1:
            s := abs(s)
            s := ((c & core.LIR_MASK) | s)
            writereg(core.TAP_CFG, s)
        other:
            return ((c & 1) == 1)


PUB click_latency(l=-2): c
' Set minimum elapsed time between first recognized click and
'   subsequent click, in usec
'   Valid values: 4_800, 9_600, 19_200, 28_800
'   Any other value polls the chip and returns the current setting
    c := readreg(core.INT_DUR2)
    case l
        4_800, 9_600, 19_200, 28_800:
            l := lookdownz(l: 4_800, 9_600, 19_200, 28_800) << core.QUIET
            l := ((c & core.QUIET_MASK) | l)
            writereg(core.INT_DUR2, l)
        other:
            c := ((c >> core.QUIET) & core.QUIET_BITS)
            return lookupz(c: 4_800, 9_600, 19_200, 28_800)


PUB click_thresh(t=-2): c | ares
' Set threshold for recognizing a click, in microseconds
'   Valid values are accel_scale()-dependent
'       2g:     0..2_000_000    (step size: 0_062_500)
'       4g:     0..4_000_000    (step size: 0_125_000)
'       8g:     0..8_000_000    (step size: 0_250_000)
'       16g:    0..16_000_000   (step size: 0_500_000)
    ares := (accel_scale(-2) * 1_000000) / 32    ' res. = scale / 32
    c := readreg(core.TAP_THS_6D)
    case t
        0..(32*ares):
            t := (t / ares)
            t := ((c & core.TAP_THS_MASK) | t)
            writereg(core.TAP_THS_6D, t)
        other:
            return (c * ares)


PUB click_time(t=-2): c
' Set maximum elapsed interval between start of click and end of click, in uSec
'   Valid values: 9_600, 19_200, 38_400, 57_600
'   Any other value polls the chip and returns the current setting
'   NOTE: accel_data_rate() should be set to 416Hz or 833Hz, per ST AN5040
    c := readreg(core.INT_DUR2)
    case t
        9_600, 19_200, 38_400, 57_600:
            t := lookdownz(t: 9_600, 19_200, 38_400, 57_600)
            t := ((c & core.SHOCK_MASK) | t)
            writereg(core.INT_DUR2, t)
        other:
            c := (c & core.SHOCK_BITS)
            return lookupz(c: 9_600, 19_200, 38_400, 57_600)


PUB dev_id(): id
' Read device identification
    return readreg(core.WHO_AM_I)


PUB fifo_accel_dec(f=-2): c
' Set decimation factor used to fill FIFO slots with accelerometer data
'   Valid values:
'       0: accel data is not used in FIFO
'       1: no decimation (every accel sample is used to fill FIFO)
'       2, 3, 4, 8, 16, 32: every n'th accel sample is used to fill FIFO
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FIFO_CTRL3)
    case f
        0, 1, 2, 3, 4, 8, 16, 32:
            f := lookdownz(f: 0, 1, 2, 3, 4, 8, 16, 32) << core.DEC_FIFO_XL
            f := ((c & core.DEC_FIFO_XL_MASK) | f)
            writereg(core.FIFO_CTRL3, f)
        other:
            c := (c >> core.DEC_FIFO_XL)
            return lookupz(c: 0, 1, 2, 3, 4, 8, 16, 32)


PUB fifo_data(p_dest, nr_smp)
' Read FIFO data
    if (lookdown(nr_smp: 5..FIFO_SAMPLES_MAX))
        readreg(core.FIFO_DATA_OUT_L, p_dest, (nr_smp * FIFO_UNIT) )
    elseif ( nr_smp <= 4 )
        long[p_dest] := readreg(core.FIFO_DATA_OUT_L, (nr_smp * FIFO_UNIT) )


PUB fifo_data_rate(r=-2): c
' Set FIFO output data rate, in Hz
'   Valid values:
'       0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660
'   Any other value polls the chip and returns the current setting
'   NOTE: This setting will effectively be no higher than the sensor output
'       data rate (e.g., if accel_data_rate() and/or gyro_data_rate() == 26,
'       the FIFO data will update at the same rate, even if it is set to 52)
    c := readreg(core.FIFO_CTRL5)
    case r
        0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660:
            r := lookdownz(r: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660) ...
                    << core.ODR_FIFO
            r := ((c & core.ODR_FIFO_MASK) | r)
            writereg(core.FIFO_CTRL5, r)
        other:
            c := ((c >> core.ODR_FIFO) & core.ODR_FIFO_BITS)
            return lookupz(c: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660)


PUB fifo_empty(): f
' Flag indicating FIFO is empty
'   Returns: TRUE (-1): FIFO empty, or FALSE (0): not empty
    f := readreg(core.FIFO_STATUS2)
    return ((f & core.FIFOEMPTY) == core.FIFOEMPTY)


PUB fifo_full(): f
' Flag indicating FIFO full
'   Returns: TRUE (-1): FIFO full, or FALSE (0): not full
    f := readreg(core.FIFO_STATUS2)
    return ((f & core.FIFOFULL) == core.FIFOFULL)


PUB fifo_gyro_dec(f=-2): c
' Set decimation factor used to fill FIFO slots with gyroscope data
'   Valid values:
'       0: gyro data not used in FIFO
'       1: no decimation (every gyro sample used to fill FIFO)
'       2, 3, 4, 8, 16, 32: every n'th gyro sample used to fill FIFO
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FIFO_CTRL3)
    case f
        0, 1, 2, 3, 4, 8, 16, 32:
            f := lookdownz(f: 0, 1, 2, 3, 4, 8, 16, 32) << core.DEC_FIFO_G
            f := ((c & core.DEC_FIFO_G_MASK) | f)
            writereg(core.FIFO_CTRL3, f)
        other:
            c := (c >> core.DEC_FIFO_G)
            return lookupz(c: 0, 1, 2, 3, 4, 8, 16, 32)


PUB fifo_mode(m=-2): c
' Set FIFO mode
'   Valid values:
'       OFF (0): FIFO disabled/bypassed
'       FIFO (1): FIFO mode - stop when FIFO is full
'       CONT_TRIG (3): Continuously fill FIFO, overwriting the oldest samples
'           first, until trigger is deasserted, then transition to FIFO mode
'       OFF_TRIG (4): FIFO off until trigger is deasserted, then transition to
'           CONT mode
'       CONT (6): Continuously fill FIFO, overwriting the oldest samples first
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FIFO_CTRL5)
    case m
        OFF, FIFO, CONT_TRIG, OFF_TRIG, CONT:
            m := ((c & core.FIFO_MODE_MASK) | m)
            writereg(core.FIFO_CTRL5, m)
        other:
            return (c & core.FIFO_MODE_BITS)


PUB fifo_overrun(): f
' Flag indicating FIFO has overrun
'   Returns: TRUE (-1): FIFO overrun, or FALSE (0): FIFO not overrun
    f := readreg(core.FIFO_STATUS2)
    return ((f & core.FIFOOVRRUN) == core.FIFOOVRRUN)


PUB fifo_thresh(l=-2): c
' Set FIFO watermark/threshold level, in words
    c := readreg(core.FIFO_CTRL1, 2)
    case l
        0..FIFO_SAMPLES_MAX:
            l := ((c & core.FTH_MASK) | l)
            writereg(core.FIFO_CTRL1, l, 2)
        other:
            return (c & core.FTH_BITS)


PUB fifo_nr_unread(): n
' Number of unread samples stored in FIFO
    n := readreg(core.FIFO_STATUS1)
    return (n & core.DIFF_FIFO_BITS)


PUB fifo_watermark(): f
' Flag indicating FIFO watermark/threshold level reached
'   Returns:
'       TRUE (-1): FIFO level at or above fifo_thresh()
'       FALSE (0): FIFO level below fifo_thresh()
    f := readreg(core.FIFO_STATUS2)
    return ((f & core.FIFOWTRMRK) == core.FIFOWTRMRK)


PUB freefall_thresh(t=-2): c
' Set free-fall threshold, in milli-g's
'   Valid values: 156, 219, 250, 312, 344, 406, 469, 500
'   Any other value polls the chip and returns the current setting
    c := readreg(core.FREE_FALL)
    case t
        156, 219, 250, 312, 344, 406, 469, 500:
            t := lookdownz(t: 156, 219, 250, 312, 344, 406, 469, 500)
            t := ((c & core.FF_THS_MASK) | t)
            writereg(core.FREE_FALL, t)
        other:
            c &= core.FF_THS_BITS
            return lookupz(c: 156, 219, 250, 312, 344, 406, 469, 500)


PUB freefall_time(t=-2): c | ffdur_b4_0, ffdur_b5
' Set minimum time duration required to recognize free-fall
    c := readreg(core.WAKEUP_DUR, 2)
    case t
        0..63:
            ' bit 5 of the FF_DUR field is in the MSB of the WAKEUP_DUR reg,
            '   but the bottom five bits are the MSBits in the next reg
            ' they aren't situated such that they can simply be isolated (&),
            '   so isolate each part separately and combine them when writing
            ffdur_b5 := ((t >> 5) & 1) << 7
            ffdur_b4_0 := (t & %11111) << 11
            t := (ffdur_b5 | ffdur_b4_0)
            t := ((c & core.FF_DUR_MASK) | t)
            writereg(core.WAKEUP_DUR, t, 2)
        other:
            ffdur_b5 := ((c >> 7) & 1) << 5
            ffdur_b4_0 := ((c >> 11) & %11111)
            return (ffdur_b5 + ffdur_b4_0)


PUB gyro_bias(x, y, z)
' Read gyroscope calibration offset values
'   x, y, z: pointers to copy offsets to
    long[x] := _gbias[X_AXIS]
    long[y] := _gbias[Y_AXIS]
    long[z] := _gbias[Z_AXIS]


PUB gyro_set_bias(x, y, z)
' Write gyroscope calibration offset values
'   Valid values:
'       -32768..32767 (clamped to range)
    _gbias[X_AXIS] := -32768 #> x <# 32767
    _gbias[Y_AXIS] := -32768 #> y <# 32767
    _gbias[Z_AXIS] := -32768 #> z <# 32767


PUB gyro_data(ptr_x, ptr_y, ptr_z) | tmp[2]
' Read the gyroscope output registers
    if (_gdata_src == GYRO_LIVE)
        readreg(core.OUTX_L_G, 6, @tmp)
    else
        fifo_data(@tmp, 3)
    long[ptr_x] := (tmp.word[X_AXIS] signx 15) - _gbias[X_AXIS]
    long[ptr_y] := (tmp.word[Y_AXIS] signx 15) - _gbias[Y_AXIS]
    long[ptr_z] := (tmp.word[Z_AXIS] signx 15) - _gbias[Z_AXIS]


PUB gyro_data_rate(r=-2): c
' Set gyroscope output data rate, in Hz
'   Valid values:
'       Low power mode: 0, 12 (12.5), 26, 52
'       Normal: 0, 104, 208
'       High-perf mode: *0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL2_G)
    case r
        0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660:
            r := lookdownz(r: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660) << core.ODR_G
            r := ((c & core.ODR_G_MASK) | r)
            writereg(core.CTRL2_G, r)
        other:
            c := (c >> core.ODR_G) & core.ODR_G_BITS
            return lookupz(c: 0, 12, 26, 52, 104, 208, 416, 833, 1660, 3330, 6660)


PUB gyro_data_rdy(): f
' Flag indicating new gyroscope data available
'   Returns: TRUE (-1) if new data available, FALSE (0) otherwise
    f := readreg(core.STATUS)
    return ((f & core.GRDY) == core.GRDY)


PUB gyro_data_src(src=-2): c
' Set source of data for gyro_data() output
'   Valid values:
'      *GYRO_LIVE (0): live/current data
'       GYRO_FIFO (1): FIFO data
'   Any other value returns the current setting
    if ((src == GYRO_LIVE) or (src == GYRO_FIFO))
        _gdata_src := src
    else
        return _gdata_src


PUB gyro_lpf_freq(f=-2): c
' Set gyroscope output data low-pass filter, in Hz
'   Valid values dependent on gyro_data_rate() setting:
'       833: 155, 195, *245, 293
'       1660: 168, 224, *315, 505
'       3300: 172, 234, *343, 925
'       6600: 173, 237, *351, 937
'       When set to other data rates, this setting has no effect
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL6_C)
    case gyro_data_rate(-2)
        833:
            case f
                155, 195, 245, 293:
                    f := lookdownz(f: 245, 195, 155, 293)
                other:
                    c := (c & core.FTYPE_BITS)
                    return lookupz(c: 245, 195, 155, 293)
        1660:
            case f
                168, 224, 315, 505:
                    f := lookdownz(f: 315, 224, 168, 505)
                other:
                    c := (c & core.FTYPE_BITS)
                    return lookupz(c: 315, 224, 168, 505)
        3330:
            case f
                172, 234, 343, 925:
                    f := lookdownz(f: 343, 234, 172, 925)
                other:
                    c := (c & core.FTYPE_BITS)
                    return lookupz(c: 343, 234, 172, 925)
        6660:
            case f
                173, 237, 351, 937:
                    f := lookdownz(f: 351, 237, 173, 937)
                other:
                    c := (c & core.FTYPE_BITS)
                    return lookupz(c: 351, 237, 173, 937)
        other:
            return

    f := ((c & core.FTYPE_MASK) | f)
    writereg(core.CTRL6_C, f)


PUB gyro_opmode(m=-2): c
' Set gyroscope operating mode
'   Valid values:
'      *NORM (0): Normal operation
'       SLEEP (1): Sleep/low-power operation
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL4_C)
    case m
        NORM, SLEEP:
            m <<= core.SLP
            m := ((c & core.SLP_MASK) | m)
            writereg(core.CTRL4_C, m)
        other:
            return (c >> core.SLP) & 1


PUB gyro_scale(s=-2): c
' Set gyroscope full-scale range, in degrees per second
'   Valid values: 125, *250, 500, 1000, 2000
'   Any other value polls the chip and returns the current setting
    c := readreg(core.CTRL2_G)
    case s
        125, 250, 500, 1000, 2000:
            ' 125dps s is a separate reg field from the other ss,
            ' but treat it as combined, for simplicity
            s := lookdownz(s: 250, 125, 500, 0, 1000, 0, 2000)
            _gres := lookupz(s: 8_750, 4_375, 17_500, 0, 35_000, 0, 70_000)
            s <<= core.FS_G
            s := ((c & core.FS_G_MASK) | s)
            writereg(core.CTRL2_G, s)
        other:
            c := (c >> core.FS_G) & core.FS_G_BITS
            return lookupz(c: 250, 125, 500, 0, 1000, 0, 2000)


PUB inact_thresh(t=-2): c | thr_res, thr_max
' Set inactivity threshold, in micro-g's
'   Valid values: TBD
'   Any other value polls the chip and returns the current setting
    thr_res := ((accel_scale(-2) * 1_000_000) / 64)
    thr_max := (thr_res * core.WK_THS_MAX)
    c := readreg(core.WAKEUP_THS)
    case t
        0..thr_max:
            t /= thr_res
            t := ((c & core.WK_THS_MASK) | t)
            writereg(core.WAKEUP_THS, t)
        other:
            return ((c & core.WK_THS_BITS) * thr_res)


PUB inact_time(t=-2): c | time_res, dur_max
' Set inactivity time, in milliseconds
'   Valid values:
'   Any other value polls the chip and returns the current setting
'   NOTE: Setting this to 0 will generate an interrupt when the acceleration
'       measures less than that set with inact_thresh()
    time_res := (512_000 / accel_data_rate(-2))
    dur_max := (time_res * core.SLP_DUR_MAX)
    c := readreg(core.WAKEUP_DUR)
    case t
        0..dur_max:
            t /= time_res
            writereg(core.WAKEUP_DUR, t)
        other:
            return ((c & core.SLP_DUR_BITS) * time_res)


PUB in_freefall(): f
' Flag indicating device is in free-fall
'   Returns:
'       TRUE (-1): device is in free-fall
'       FALSE (0): device isn't in free-fall
    f := readreg(core.WAKEUP_SRC)
    return ((f & core.FREEFALL) == core.FREEFALL)


PUB int_inactivity(): f
' Flag indicating inactivity interrupt asserted
    f := readreg(core.WAKEUP_SRC)
    return (((f >> core.SLPST_IA) & 1) == 1)


PUB int1_mask(m=-2): c
' Set INT1 pin interrupt mask
'   Valid values:
'       Bit 7..0
'       7 - Inactivity
'       6 - Single-tap
'       5 - Wakeup
'       4 - Free-fall
'       3 - Double-tap
'       2 - 6D
'       1 - Tilt
'       0 - Timer: counter ended
    case m
        0..%11111111:
            writereg(core.MD1_CFG, m)
        other:
            return readreg(core.MD1_CFG)


PUB pedometer_ena(s=-2): c
' Enable pedometer functionality
'   Valid values:
'       TRUE (-1 or 1), FALSE (0)
' Any other value returns the current setting
    c := readreg(core.CTRL10_C)
    case abs(s)
        0, 1:
            s := ((s & core.PED_EN_MASK) | (s & 1) | (1 << core.FUNC_EN))
            writereg(core.CTRL10_C, s)
        other:
            return (((c >> core.PED_EN) & 1) == 1)


PUB pedometer_scale(s=-2): c
' Set pedometer full-scale
'   Valid values:
'       2, 4
' Any other value returns the current setting
    c := readreg(core.CFG_PED_THRESH)
    case s
        2, 4:
            s := lookdownz(s: 2, 4)
            s := ((c & core.PED_FS_MASK) | s)
            writereg(core.CFG_PED_THRESH, s)
        other:
            return lookupz( ((c >> core.PED_FS) & 1): 2, 4 )


PUB reset()
' Reset the device
    writereg(core.CTRL3_C, core.RESET)


PUB step_count(): c
' Number of steps detected by pedometer function
'   Returns: integer (u16)
    return readreg(core.STP_CNTR_L, 2)


PUB step_reset() | tmp
' Reset the pedometer's step counter
    tmp := readreg(core.CTRL10_C)
    tmp |= (1 << core.PED_RST_STP)
    writereg(core.CTRL10_C, tmp)


CON

    BANK_A = core.BANK_A
    BANK_B = core.BANK_B

VAR

    byte _bank_sel

PRI bank_sel(bnk)
' Select register bank
'   Valid values:
'       0: bank A and B disabled
'       BANK_A ($80): bank A
'       BANK_B ($A0): bank B
    case bnk
        0, BANK_A, BANK_B:
            if ( bnk <> _bank_sel )             ' only update if the last bank_sel() was different
#ifdef LSM6DSL_I2C
                i2c.start()
                i2c.write(SLAVE_WR)
                i2c.write(core.FUNC_CFG_ACCESS)
                i2c.write(bnk)
                i2c.stop()
#elseifdef LSM6DSL_SPI
                outa[_CS] := 0
                spi.wr_byte(core.FUNC_CFG_ACCESS)
                spi.wr_byte(bnk)
                outa[_CS] := 1
            _bank_sel := bnk                    ' save the selection for next time
#endif


PRI blk_updt_ena() | tmp
' Enable block data updates
'   (wait until MSB and LSB registers are updated internally to update the
'   values stored therein)

    tmp := readreg(core.CTRL3_C)

    tmp |= (1 << core.BDU)

    writereg(core.CTRL3_C, tmp)


PRI readreg(reg_nr, len=1, p_dest=0): v | cmd_pkt, dest
' Read nr_bytes from the device into ptr_buff
    case reg_nr                                 ' validate register num
        core.OUT_TEMP_L..core.OUTZ_H_XL, core.OUT_MAG_RAW_X_L:
            dest := p_dest
        core.FUNC_CFG_ACCESS, core.SENS_SYNC_TIMEFR..core.DRDY_PULSE_CFG_G, ...
        core.INT1_CTRL..core.STATUS, core.SENSHUB1..core.TIMESTAMP2, ...
        core.STP_TIMESTMP_L..core.WRIST_TILT_IA, ...
        core.TAP_CFG..core.SENS_SYNC_SPI_ERR, core.X_OFS_USR..core.Z_OFS_USR, ...
        core.SLV0_ADD..core.CFG_PED_THRESH, core.SM_THS..core.STEP_CNT_DELTA, ...
        core.MAG_SI_XX..core.MAG_OFFZ_H:
            bank_sel(reg_nr.byte[1])
            dest := @v
        other:                                  ' invalid reg_nr
            return

#ifdef LSM6DSL_I2C
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 2)
    i2c.start()
    i2c.write(SLAVE_RD)
    i2c.rdblock_lsbf(dest, len, i2c.NAK)
    i2c.stop()
#elseifdef LSM6DSL_SPI
    pinl(_CS)
    spi.wr_byte(reg_nr | core.READ)

    ' read LSByte to MSByte
    spi.rdblock_lsbf(dest, len)
    pinh(_CS)
#endif


PRI writereg(reg_nr, val, len=1) | cmd_pkt
' Write nr_bytes to the device from ptr_buff
    case reg_nr
        core.FUNC_CFG_ACCESS, core.SENS_SYNC_TIMEFR..core.DRDY_PULSE_CFG_G, core.INT1_CTRL, ...
        core.INT2_CTRL, core.CTRL1_XL..core.MASTER_CFG, core.TIMESTAMP2, ...
        core.TAP_CFG..core.SENS_SYNC_SPI_ERR, core.X_OFS_USR..core.Z_OFS_USR, ...
        core.SLV0_ADD..core.CFG_PED_THRESH, core.SM_THS..core.STEP_CNT_DELTA, ...
        core.MAG_SI_XX..core.MAG_OFFZ_H:
            bank_sel(reg_nr.byte[1])
        other:
            return

#ifdef LSM6DSL_I2C
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 2)
    i2c.wrblock_lsbf(@val, len)
    i2c.stop()
#elseifdef LSM6DSL_SPI
    pinl(_CS)
    spi.wr_byte(reg_nr)

    ' write LSByte to MSByte
    spi.wrblock_lsbf(@val, len)
    pinh(_CS)
#endif

DAT
